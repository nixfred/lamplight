def scene_options(cfg, sku, device):
    """{scene name: lightScene value} for a SKU, from Govee's cloud, cached.

    Unlike scene_catalog this needs no colour data, so it covers the light
    bars too, whose scene params are not the PNG frames the lamps use.
    """
    path = os.path.join(SCENE_CACHE, "options-%s.json" % sku)
    try:
        if time.time() - os.path.getmtime(path) < 7 * 86400:
            with open(path) as fh:
                return json.load(fh)
    except OSError:
        pass
    key = os.environ.get("GOVEE_API_KEY") or cfg.get("api_key")
    if not (key and device):
        return {}
    try:
        body = json.dumps({"requestId": str(uuid.uuid4()),
                           "payload": {"sku": sku, "device": device}}).encode()
        req = urllib.request.Request(SCENES_URL, data=body, headers={
            "Content-Type": "application/json", "Govee-API-Key": key})
        with urllib.request.urlopen(req, timeout=15) as resp:
            opts = json.load(resp)["payload"]["capabilities"][0]["parameters"]["options"]
    except Exception as exc:  # noqa: BLE001
        print("scene options unavailable: %s" % exc, file=sys.stderr)
        return {}
    out = {o["name"]: o["value"] for o in opts}
    if out:
        os.makedirs(SCENE_CACHE, exist_ok=True)
        with open(path, "w") as fh:
            json.dump(out, fh)
    return out


def theme_scene_step(cfg, lamp, theme, step):
    """Put every unit on scene `step` of the theme's playlist.

    Returns True when the theme has a playlist (the caller then leaves those
    units alone), False to fall back to colour matching and lava.
    """
    import threading
    picks = THEME_SCENES.get(theme)
    if not picks:
        return False
    for d in lamp.devices:
        if not getattr(d, "device_id", None):
            continue
        names = picks[1] if d.segments else picks[0]
        opts = scene_options(cfg, d.sku, d.device_id)
        names = [n for n in names if n in opts]
        if not names:
            continue
        name = names[step % len(names)]
        if getattr(d, "scene", None) == name:
            continue
        d.scene = name
        print("scene %s -> %s" % (d.name, name), file=sys.stderr)
        threading.Thread(target=cloud_control, daemon=True, args=(cfg, {
            "type": "devices.capabilities.dynamic_scene",
            "instance": "lightScene", "value": opts[name]}),
            kwargs={"sku": d.sku, "device": d.device_id}).start()
    return True


def theme_lava_set(cols, k=4):
    """Up to k theme colours, vivid, spread as far apart in hue as it has.

    Starts from the theme's first (accent) colour so the set is stable for a
    theme, then adds whichever colour is furthest from those already chosen.
    """
    import colorsys
    viv = [_vivid(c) for c in cols]
    hue = [colorsys.rgb_to_hsv(*(v / 255.0 for v in c))[0] for c in viv]

    def dist(a, b):
        d = abs(hue[a] - hue[b])
        return min(d, 1 - d)

    pick = [0]
    while len(pick) < min(k, len(viv)):
        pick.append(max((i for i in range(len(viv)) if i not in pick),
                        key=lambda i: min(dist(i, j) for j in pick)))
    return [viv[i] for i in pick]


def cmd_lava(cfg, args):
    """The whole fleet rolls the theme's colours; a theme switch recolours it.

    Light bars roll a lava gradient over their segments (LAN); the lamps play
    the Govee scene whose colours best match the theme (cloud, one call per
    theme change). Workspaces play no part.
    """
    claim()
    lamp = Lamp(cfg)
    period = max(4.0, _num(cfg.get("lava_period", 12), 12))
    fps = 8.0
    stamp, cur, prev, switched = None, None, None, 0.0
    t0 = time.time()
    rotate = max(1.0, _num(cfg.get("scene_rotate", 10), 10)) * 60
    playing, step, stepped = False, 0, 0.0
    while True:
        if playing and time.time() - stepped >= rotate:
            step, stepped = step + 1, time.time()
            theme_scene_step(cfg, lamp, theme_name(), step)
        if theme_stamp() != stamp:
            stamp = theme_stamp()
            prev, cur = cur, theme_lava_set(distinct_colors())
            switched = time.time()
            for d in lamp.devices:
                d.scene = None
            step, stepped = 0, time.time()
            playing = bool(cfg.get("theme_scenes", True)) and \
                theme_scene_step(cfg, lamp, theme_name(), step)
            if not playing and cfg.get("lamp_scenes", True):
                # Real theme colours on the matrix lamps over LAN; any unit we
                # cannot build a scene for falls back to the nearest stock one.
                rest = []
                for d in lamp.devices:
                    if d.segments:
                        continue
                    # Experimental: our own theme-coloured scene over LAN.
                    # Unproven on the real lamps (2026-09-30: results dim or
                    # dark), so off unless "lamp_theme_scene": true.
                    pk = None
                    if cfg.get("lamp_theme_scene", False):
                        try:
                            pk = theme_scene_packets(d.sku, cur)
                        except Exception as exc:  # noqa: BLE001
                            print("theme scene failed: %s" % exc, file=sys.stderr)
                    if pk:
                        d.power(True)
                        d.ptreal(*pk)
                        d.scene = "theme"
                    else:
                        rest.append(d)
                if rest:
                    sub = Lamp.__new__(Lamp)
                    sub.cfg, sub.devices = cfg, rest
                    scene_lamps_to(cfg, sub, cur)
        k = min(1.0, (time.time() - switched) / 1.5)
        sets = [(1 - k, prev), (k, cur)] if prev and k < 1.0 else [(1.0, cur)]
        roll = bool(cfg.get("bar_roll", False))
        lava_frame(lamp, sets, time.time() - t0, period, cfg_roll=roll,
                   bars_set=None if roll else theme_lava_set(distinct_colors(), 6))
        time.sleep(1.0 / fps)


def _lava_at(cols, x):
    """Smooth closed loop through cols; x wraps at 1.0 (cosine eased)."""
    n = len(cols)
    x = (x % 1.0) * n
    i = int(x) % n
    t = x - int(x)
    t = (1 - math.cos(t * math.pi)) / 2
    return lerp(cols[i], cols[(i + 1) % n], t)


def lava_set(cols, ws):
    """The workspace's own colour first, then its palette neighbours."""
    # Spread across the palette, not its neighbours: adjacent entries in a
    # theme are often near-twins, and a loop of twins reads as a still light.
    import colorsys
    viv = [_vivid(c) for c in cols]
    hue = [colorsys.rgb_to_hsv(*(v / 255.0 for v in c))[0] for c in viv]

    def dist(a, b):
        d = abs(hue[a] - hue[b])
        return min(d, 1 - d)

    # The workspace's own colour, then whichever theme colours sit furthest
    # from it on the wheel. The bars diffuse neighbouring segments together,
    # so near hues (a blue beside an aqua) blur into one flat light.
    pick = [(ws - 1) % len(viv)]
    while len(pick) < min(3, len(viv)):
        pick.append(max((i for i in range(len(viv)) if i not in pick),
                        key=lambda i: min(dist(i, j) for j in pick)))
    return [viv[i] for i in pick]


def _vivid(rgb, min_s=0.85):
    """Keep the theme's hue, lift saturation and value for LEDs.

    Theme palettes are tuned for screens; pastels like #cddbf4 render as
    plain white on a diffused LED bar, so a pastel gradient looks solid.
    """
    import colorsys
    h, s, v = colorsys.rgb_to_hsv(*(c / 255.0 for c in rgb))
    r, g, b = colorsys.hsv_to_rgb(h, max(s, min_s), 1.0)
    return (r * 255, g * 255, b * 255)


def lava_frame(lamp, sets, t, period, cfg_roll=True, bars_set=None):
    """Paint one frame of the rolling gradient.

    Segmented units get a diagonal band that rolls along their segments with a
    slow wobble, like the lamp's own gradient scenes; single-colour units flow
    through the same loop, each one a phase apart so the fleet never moves in
    lockstep. `sets` is [(weight, colours)] so a workspace switch crossfades.
    """
    def at(x):
        out = (0.0, 0.0, 0.0)
        for w, cs in sets:
            c = _lava_at(cs, x)
            out = tuple(o + w * v for o, v in zip(out, c))
        return out

    roll = t / period
    for idx, d in enumerate(lamp.devices):
        phase = idx * 0.37
        try:
            n = d.segments
            if n and getattr(d, "scene", None):
                continue  # the bars are playing a Govee scene
            if n:
                # The H6056 is two towers of n/2 segments; give each tower the
                # whole colour loop so the band is visible on both, and ride a
                # bright/dim wave over it so blobs read as motion even when a
                # theme's colours are close in hue.
                per = max(1, n // 2)
                if not cfg_roll:
                    # Each tower one solid theme colour, the two always
                    # different, stepping through the theme every HOLD
                    # seconds with a short fade. A whole tower is one masked
                    # packet, so a frame is two datagrams, not twelve.
                    band = bars_set or [c for _, cs in sets for c in cs]
                    k = len(band)
                    HOLD, FADE = 4.0, 1.0
                    step, into = divmod(t, HOLD)
                    step = int(step)
                    f = min(1.0, into / FADE)
                    for tower in range(2):
                        off = tower * max(1, k // 2)
                        c = lerp(band[(step - 1 + off) % k], band[(step + off) % k], f)
                        c = tuple(int(max(0, min(255, v))) for v in c)
                        if getattr(d, "_tower_last", {}).get(tower) == c:
                            continue
                        mask = ((1 << per) - 1) << (tower * per)
                        d.ptreal([0x33, 0x05, 0x15, 0x01, c[0], c[1], c[2],
                                  0, 0, 0, 0, 0, mask & 0xFF, (mask >> 8) & 0xFF])
                        d.__dict__.setdefault("_tower_last", {})[tower] = c
                    d._last_rgb = None
                    continue
                frame = []
                for i in range(n):
                    x = (i % per) / per
                    tower = i // per
                    c = at(roll + phase + tower * 0.5 + x)
                    blob = 0.9 + 0.1 * math.sin(
                        2 * math.pi * (x * 1.5 - t / (period * 0.6)) + tower * 2.1)
                    frame.append(scale(c, blob))
                d.segment_colors(frame)
            elif not getattr(d, "scene", None):
                d.color(at(roll + phase))
        except OSError:
            pass


def cmd_workspace(cfg, args):
    """Give every workspace its own colour from the theme.

    Driven off Hyprland's event socket rather than polling, so the lamp turns
    over as the workspace does instead of up to a second later.

    The colour is the palette entry at (workspace - 1) modulo the palette
    length, so the mapping is stable for a given theme and wraps for people
    with more workspaces than the theme has colours.
    """
    ms = int(_num(_opt(args, "--ms", 350), 350))
    claim()
    lamp = Lamp(cfg)
    cols = distinct_colors()
    stamp = theme_stamp()
    last_ws = None

    # Lava: roll each unit through the workspace's theme colours instead of
    # resting on one. On by default; "workspace_lava": false restores the
    # plain one-colour-per-workspace behaviour.
    lava = bool(cfg.get("workspace_lava", False))
    period = max(4.0, _num(cfg.get("lava_period", 12), 12))
    fps = 8.0
    anim = {"sets": [], "from": None, "switched": 0.0}
    t0 = time.time()

    def paint(ws, force=False):
        if ws is None:
            return
        if lava:
            new = lava_set(cols, ws)
            scene_lamps(new)
            cur = anim["sets"][-1][1] if anim["sets"] else None
            anim["from"] = cur if cur and not force else None
            anim["to"] = new
            anim["switched"] = time.time()
            tick()
            return
        rgb = cols[(ws - 1) % len(cols)]
        lamp.fade(rgb, ms)

    use_scenes = lava and bool(cfg.get("lamp_scenes", True))

    def scene_lamps(want):
        if use_scenes:
            scene_lamps_to(cfg, lamp, want)

    def tick():
        if not lava or "to" not in anim:
            return
        now = time.time()
        k = min(1.0, (now - anim["switched"]) / max(0.05, ms / 1000.0 * 2))
        if anim["from"] and k < 1.0:
            anim["sets"] = [(1 - k, anim["from"]), (k, anim["to"])]
        else:
            anim["sets"] = [(1.0, anim["to"])]
        lava_frame(lamp, anim["sets"], now - t0, period)

    sock_path = hypr_socket()
    if not sock_path:
        print("no Hyprland event socket found", file=sys.stderr)
        return 1

    while True:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(sock_path)
            sock.settimeout(1.0 / fps if lava else 1.0)
        except OSError:
            time.sleep(3)
            sock_path = hypr_socket() or sock_path
            continue

        last_ws = active_workspace()
        paint(last_ws, force=True)

        buf = ""
        try:
            while True:
                # A theme switch has to recolour the CURRENT workspace too, and
                # the socket may be silent for hours, so the read is given a
                # timeout rather than blocking forever.
                if theme_stamp() != stamp:
                    stamp = theme_stamp()
                    cols = distinct_colors()
                    paint(last_ws, force=True)
                try:
                    chunk = sock.recv(8192).decode("utf-8", "replace")
                except socket.timeout:
                    tick()
                    continue
                if not chunk:
                    break
                buf += chunk
                tick()
                while "\n" in buf:
                    line, _, buf = buf.partition("\n")
                    name, _, payload = line.partition(">>")
                    ws = None
                    if name == "workspacev2":
                        # "ID,NAME" -- prefer the id, names can be anything
                        # once the workspace-names plugin is in play.
                        try:
                            ws = int(payload.split(",", 1)[0])
                        except ValueError:
                            ws = None
                    elif name == "workspace":
                        try:
                            ws = int(payload)
                        except ValueError:
                            ws = active_workspace()
                    elif name == "focusedmon":
                        # Focus moved to another monitor; its active workspace
                        # is not in the payload in a form we can trust.
                        ws = active_workspace()
                    if ws is not None and ws != last_ws:
                        last_ws = ws
                        paint(ws)
        except OSError:
            pass
        finally:
            sock.close()
        time.sleep(1)


def cmd_mix_mode(cfg, args):
    """Every device wears a different theme colour, together.

    Holds still until something changes: the theme, the mix index (the left
    pedal bumps it), or the fleet. Re-read from disk each tick so an external
    nudge lands without restarting the effect.
    """
    ms = int(_num(_opt(args, "--ms", 1400), 1400))
    claim()
    lamp = Lamp(cfg)
    if not lamp.devices:
        print("no devices configured; run: govee-lamp devices scan", file=sys.stderr)
        return 1
    stamp = None
    shown = None
    while True:
        idx = int(cfg_value(cfg, "mix_index", 0))
        now = (theme_stamp(), idx, len(lamp.devices))
        if now != stamp:
            stamp = now
            targets = mix_colors(len(lamp.devices), idx)
            lamp.fade_multi(targets, ms, starts=shown)
            shown = targets
        time.sleep(0.5)


def cmd_mix(cfg, args):
    """Show, set, or advance which mix the fleet is wearing."""
    total = mix_count()
    cur = int(_num(cfg.get("mix_index", 0), 0))
    if args and args[0] == "next":
        cur = (cur + 1) % total
    elif args and args[0] == "prev":
        cur = (cur - 1) % total
    elif args:
        cur = int(_num(args[0], cur)) % total
    else:
        n = len(Lamp(cfg).devices) or 4
        print("mix %d of %d: %s" % (cur, total,
              " ".join(rgb_hex(c) for c in mix_colors(n, cur))))
        return 0
    cfg["mix_index"] = cur
    save_config(cfg)
    n = len(Lamp(cfg).devices) or 4
    print("mix %d of %d: %s" % (cur, total,
          " ".join(rgb_hex(c) for c in mix_colors(n, cur))))
    return 0


def cmd_ambient_cycle(cfg, args):
    """Seconds for one full lap of the palette. Applied live, no restart."""
    if not args:
        print(cfg.get("ambient_cycle", AMBIENT_CYCLE_DEFAULT))
        return 0
    try:
        val = float(args[0])
    except (TypeError, ValueError):
        print("cycle must be a number of seconds", file=sys.stderr)
        return 2
    cfg["ambient_cycle"] = max(AMBIENT_CYCLE_MIN, min(AMBIENT_CYCLE_MAX, val))
    save_config(cfg)
    print("ambient cycle %gs" % cfg["ambient_cycle"])
    return 0


def cmd_devices(cfg, args):
    """List the fleet, or add every Govee unit answering on the LAN.

    `devices scan` is the unboxing command: flip LAN Control on in the app,
    run it, and each new unit joins the fleet with its sku and device id.
    """
    sub = args[0] if args else "list"

    if sub == "scan":
        hits = discover(cfg, timeout=6)
        if not hits:
            print("nothing answered. Turn LAN Control on for each device in the")
            print("Govee Home app, then run this again.")
            return 1
        devs = cfg.get("devices")
        if not isinstance(devs, list):
            devs = [d for d in device_list(cfg)]
        by_ip = {d.get("ip"): d for d in devs}
        added = 0
        for ip, info in sorted(hits.items()):
            entry = by_ip.get(ip)
            if entry is None:
                entry = {"name": info.get("sku", "govee") + " " + ip.split(".")[-1],
                         "ip": ip, "enabled": True}
                devs.append(entry)
                added += 1
                print("  added   %-15s %s" % (ip, info.get("sku", "?")))
            else:
                print("  known   %-15s %s" % (ip, info.get("sku", "?")))
            entry["sku"] = info.get("sku", entry.get("sku", ""))
            entry["device_id"] = info.get("device", entry.get("device_id"))
        cfg["devices"] = devs
        save_config(cfg)
        print("%d added, %d total. Rename them in %s" % (added, len(devs), CONFIG))
        return 0

    if sub in ("enable", "disable") and len(args) > 1:
        want = args[1].lower()
        devs = cfg.get("devices") or device_list(cfg)
        hit = False
        for d in devs:
            if want in (d.get("name", "").lower(), d.get("ip", "")):
                d["enabled"] = (sub == "enable")
                hit = True
        if not hit:
            print("no device matching %r" % args[1], file=sys.stderr)
            return 2
        cfg["devices"] = devs
        save_config(cfg)
        print("%sd %s" % (sub, args[1]))
        return 0

    devs = cfg.get("devices")
    if not isinstance(devs, list) or not devs:
        devs = device_list(cfg)
    if not devs:
        print("no devices. Run: govee-lamp devices scan")
        return 1
    lamp = Lamp(cfg)
    live = {ip: st for _, ip, st in lamp.statuses(timeout=2)}
    for d in devs:
        st = live.get(d.get("ip"))
        print("  %-20s %-15s %-7s %-9s %s" % (
            d.get("name", "?"), d.get("ip", "?"), d.get("sku", "?"),
            "enabled" if d.get("enabled", True) else "disabled",
            ("%s on=%s bri=%s" % (rgb_hex((st.get("color", {}).get("r", 0),
                                           st.get("color", {}).get("g", 0),
                                           st.get("color", {}).get("b", 0))),
                                  st.get("onOff"), st.get("brightness")))
            if st else "SILENT"))
    return 0


def cmd_gauge_source(cfg, args):
    """Pick what the gauge measures, and relight it if it is the live mode."""
    if not args:
        print(cfg.get("gauge_source", "claude"))
        return 0
    name = args[0].lower()
    if name not in SOURCES:
        print("source must be one of: %s" % ", ".join(SOURCES), file=sys.stderr)
        return 2
    cfg["gauge_source"] = name
    save_config(cfg)
    if cfg.get("mode") == "gauge":
        subprocess.run(["systemctl", "--user", "restart", UNIT],
                       capture_output=True, timeout=30)
    print("gauge source %s" % name)
    return 0


def _device_json(name, ip, st):
    """One device's state, flattened for the bar plugin."""
    c = (st or {}).get("color") or {}
    return {
        "name": name,
        "ip": ip,
        "reachable": bool(st),
        "on": bool((st or {}).get("onOff", 0)),
        "brightness": (st or {}).get("brightness", 0),
        "color": rgb_hex((c.get("r", 0), c.get("g", 0), c.get("b", 0))) if st else None,
    }


def cmd_json(cfg, args):
    """Machine-readable state for the bar plugin. Never fails, never blocks long."""
    fleet = Lamp(cfg)
    # The bar polls this every few seconds. Probing every device serially costs
    # a full timeout per unreachable unit (measured 11.3s on a fleet of four
    # with three down), which overruns the poll interval and stacks up. So the
    # frequent path probes only the primary; --all is for the panel and the
    # devices command, where a pause is acceptable.
    if "--all" in args and fleet.devices:
        per = fleet.statuses(timeout=2)
    elif fleet.devices:
        d = fleet.devices[0]
        per = [(d.name, d.ip, d.status(timeout=2))]
        per += [(x.name, x.ip, None) for x in fleet.devices[1:]]
    else:
        per = []
    live = next((st for _, _, st in per if st), None)
    col = (live or {}).get("color", {}) or {}
    out = {
        "name": cfg.get("name", "Lamp"),
        "mode": cfg.get("mode", "theme"),
        "modes": list(MODES),
        "reachable": bool(live),
        "devices": [_device_json(n, i, st) for n, i, st in per],
        "deviceCount": len(fleet.devices),
        "probedAll": "--all" in args,
        "on": bool((live or {}).get("onOff", 0)),
        "brightness": (live or {}).get("brightness", 0),
        "lamp": rgb_hex((col.get("r", 0), col.get("g", 0), col.get("b", 0))) if live else None,
        "theme": theme_name(),
        "themeColor": rgb_hex(theme_color()),
        "palette": [rgb_hex(c) for c in theme_colors()],
        "workspaceColors": [rgb_hex(c) for c in distinct_colors()],
        "mixIndex": int(_num(cfg.get("mix_index", 0), 0)),
        "mixCount": mix_count(),
        "mixColors": [rgb_hex(c) for c in mix_colors(max(1, len(fleet.devices)), int(_num(cfg.get("mix_index", 0), 0)))],
        "effect": daemon_pid() or 0,
        "gaugeSource": cfg.get("gauge_source", "claude"),
        "gaugeSources": list(SOURCES),
        "workspace": active_workspace() or 0,
        "ambientCycle": _num(cfg.get("ambient_cycle"), AMBIENT_CYCLE_DEFAULT),
        "ambientCycleMin": AMBIENT_CYCLE_MIN,
        "ambientCycleMax": AMBIENT_CYCLE_MAX,
    }
    print(json.dumps(out))
    return 0


# ---------------------------------------------------------------- bluetooth


# The lamp is also a JBL Bluetooth speaker. Its BR/EDR radio only advertises
# while in pairing mode, entered by holding Play/Pause on the lamp (or from
# Device Settings in the Govee Home app) -- it cannot be woken over the LAN
# API. So this waits for it to appear rather than failing fast.
BT_NAME_RE = re.compile(r"govee|jbl|table lamp", re.I)


def _btctl(*args, timeout=30):
    try:
        out = subprocess.run(["bluetoothctl", *args], capture_output=True,
                             text=True, timeout=timeout)
        return out.stdout + out.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return str(exc)


def bt_find():
    for line in _btctl("devices").splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0] == "Device" and BT_NAME_RE.search(parts[2]):
            return parts[1], parts[2].strip()
    return None


def cmd_pair(cfg, args):
    wait = int(_opt(args, "--wait", 90))
    _btctl("power", "on")
    print("Put the lamp into pairing mode: hold Play/Pause until it flashes blue")
    print("and plays the pairing tone (or Govee Home app -> Device Settings ->")
    print("Bluetooth pairing). Waiting up to %ds..." % wait)
    hit = bt_find()
    end = time.time() + wait
    while not hit and time.time() < end:
        _btctl("--timeout", "8", "scan", "on", timeout=20)
        hit = bt_find()
    if not hit:
        print("no Govee/JBL speaker appeared. Is it in pairing mode?")
        return 1
    mac, name = hit
    print("found %s (%s)" % (name, mac))
    for step in ("pair", "trust", "connect"):
        out = _btctl(step, mac, timeout=45)
        ok = "successful" in out.lower() or "already" in out.lower()
        print("  %-8s %s" % (step, "ok" if ok else (out.strip().splitlines() or ["?"])[-1]))
    cfg["bt_mac"], cfg["bt_name"] = mac, name
    save_config(cfg)
    print("saved bt_mac to %s" % CONFIG)
    return 0


# ---------------------------------------------------------------- commands


def _opt(args, flag, default=None):
    if flag in args:
        try:
            return args[args.index(flag) + 1]
        except IndexError:
            return default
    return default


def cmd_theme(cfg, args):
    # A running effect re-reads the palette itself; stepping on it here would
    # just make two writers fight over the lamp.
    if daemon_pid() and "--force" not in args:
        return 0
    rgb = theme_color()
    ms = int(_num(_opt(args, "--ms", 900), 900))
    lamp = Lamp(cfg)
    if cfg.get("brightness"):
        lamp.brightness(int(_num(cfg["brightness"], 100)))
    lamp.fade(rgb, ms)
    print("theme %s -> %s" % (theme_name(), rgb_hex(rgb)))
    return 0


def cmd_color(cfg, args):
    if not args:
        print("usage: govee-lamp color '#rrggbb' [--ms N]", file=sys.stderr)
        return 2
    stop_daemon(quiet=True)
    lamp = Lamp(cfg)
    lamp.fade(hex_rgb(args[0]), int(_num(_opt(args, "--ms", 600), 600)))
    print("-> %s" % rgb_hex(hex_rgb(args[0])))
    return 0


def cmd_brightness(cfg, args):
    if not args:
        print("usage: govee-lamp brightness 0-100", file=sys.stderr)
        return 2
    Lamp(cfg).brightness(int(args[0]), force=True)
    print("brightness %s" % args[0])
    return 0


def cmd_power(cfg, on):
    if not on:
        stop_daemon(quiet=True)
    Lamp(cfg).power(on)
    print("turned %s" % ("on" if on else "off"))
    return 0


def cmd_discover(cfg, args):
    hits = discover(cfg, timeout=6)
    if not hits:
        print("no Govee devices answered the LAN API.")
        print("Check LAN Control in the Govee Home app, and that ufw allows")
        print("udp/4002 in from the LAN (replies are dropped otherwise).")
        return 1
    for ip, info in hits.items():
        print("%-15s %s %s" % (ip, info.get("sku", "?"), info.get("device", "")))
    return 0


def cmd_status(cfg, args):
    lamp = Lamp(cfg)
    pid = daemon_pid()
    print("devices       : %d" % len(lamp.devices))
    print("theme         : %s" % theme_name())
    print("theme colour  : %s" % rgb_hex(theme_color()))
    print("palette       : %s" % " ".join(rgb_hex(c) for c in theme_colors()))
    print("effect        : %s" % ("running (pid %d)" % pid if pid else "none"))
    ok = False
    for name, ip, st in lamp.statuses(timeout=2):
        if st:
            ok = True
            c = st.get("color", {})
            print("  %-18s %-15s %s  on=%s brightness=%s" % (
                name, ip, rgb_hex((c.get("r", 0), c.get("g", 0), c.get("b", 0))),
                st.get("onOff"), st.get("brightness")))
        else:
            print("  %-18s %-15s SILENT (LAN Control off, wrong ip, or ufw udp/4002)"
                  % (name, ip))
    return 0 if ok else 1


USAGE = """usage: govee-lamp <command>

  theme [--ms N]           fade to the current Omarchy theme colour
  color '#rrggbb' [--ms N] fade to an explicit colour
  brightness 0-100         set brightness
  on | off                 power

effects (one at a time; each follows theme changes live)
  mix [next|prev|N]                   which set of theme colours the fleet wears
  ambient [--cycle S]                 fade around the whole theme palette,
                                      one full lap every S seconds (5-60)
  gauge [--source S] [--pulse]        lamp as a meter: theme colour -> red
                                      sources: %s
  workspace                           one theme colour per Hyprland workspace,
                                      switched off the compositor's event socket
  circadian                           follow the sun along the theme's own
                                      cool-to-warm colours; dims after sunset
  weather                             outside temperature on that same axis,
                                      dimmed by cloud cover (open-meteo, keyless)
  events                              rest on the theme colour, tint only when
                                      something happens
  music [--rainbow] [--gain N]        react to what the JBL speaker is playing
  stop                                stop the running effect

  mode <name>                         set the persistent mode driven by the
                                      plugin and the systemd unit
  flash ok|warn|fail|info             ring the events effect from a script
  gauge-source <name>                 what the gauge measures
  ambient-cycle <seconds>             seconds per full lap of the palette

  pair [--wait N]          pair the lamp's JBL speaker over Bluetooth
  devices [scan|enable X|disable X]
                           list the fleet, or add every unit answering on the LAN
  discover                 find Govee devices answering the LAN API
  status                   config, palette, running effect, live lamp state
""" % ", ".join(SOURCES)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cfg = load_config()
    cmd, args = argv[0], argv[1:]
    table = {
        "theme": lambda: cmd_theme(cfg, args),
        "color": lambda: cmd_color(cfg, args),
        "colour": lambda: cmd_color(cfg, args),
        "brightness": lambda: cmd_brightness(cfg, args),
        "on": lambda: cmd_power(cfg, True),
        "off": lambda: cmd_power(cfg, False),
        "ambient": lambda: cmd_ambient(cfg, args),
        "workspace": lambda: cmd_workspace(cfg, args),
        "mix": lambda: cmd_mix(cfg, args),
        "mix-mode": lambda: cmd_mix_mode(cfg, args),
        "circadian": lambda: cmd_circadian(cfg, args),
        "weather": lambda: cmd_weather(cfg, args),
        "events": lambda: cmd_events(cfg, args),
        "flash": lambda: cmd_flash(cfg, args),
        "mode": lambda: cmd_mode(cfg, args),
        "run": lambda: cmd_run(cfg, args),
        "json": lambda: cmd_json(cfg, args),
        "gauge-source": lambda: cmd_gauge_source(cfg, args),
        "ambient-cycle": lambda: cmd_ambient_cycle(cfg, args),
        "gauge": lambda: cmd_status_fx(cfg, args),
        "music": lambda: cmd_music(cfg, args),
        "stop": lambda: 0 if stop_daemon() else 1,
        "pair": lambda: cmd_pair(cfg, args),
        "discover": lambda: cmd_discover(cfg, args),
        "status": lambda: cmd_status(cfg, args),
        "devices": lambda: cmd_devices(cfg, args),
    }
    if cmd not in table:
        print(USAGE, file=sys.stderr)
        return 2
    return table[cmd]()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
